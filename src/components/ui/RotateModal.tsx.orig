import React, { useState, useEffect } from 'react';
import { X, RotateCw } from 'lucide-react';
import { PDFPageThumbnail } from '../pdf/reorder/PDFPageThumbnail';

interface RotateModalProps {
  isOpen: boolean;
  title: string;
  docId: string;
  pageCount: number;
  thumbnailCache: Record<string, string>;
  setThumbnailCache: React.Dispatch<React.SetStateAction<Record<string, string>>>;
  onConfirm: (pageRotations: Record<number, number>) => void;
  onCancel: () => void;
}

export function RotateModal({
  isOpen,
  title,
  docId,
  pageCount,
  thumbnailCache,
  setThumbnailCache,
  onConfirm,
  onCancel,
}: RotateModalProps) {
  // pageNum (1-indexed) -> degrees (90, 180, 270)
  const [rotations, setRotations] = useState<Record<number, number>>({});

  useEffect(() => {
    if (isOpen) {
      setRotations({});
    }
  }, [isOpen]);

  if (!isOpen) return null;

  const handleRotatePage = (pageNum: number) => {
    setRotations(prev => ({
      ...prev,
      [pageNum]: ((prev[pageNum] || 0) + 90) % 360
    }));
  };

  const handleRotateAll = () => {
    setRotations(prev => {
      const newRotations = { ...prev };
      for (let i = 1; i <= pageCount; i++) {
        newRotations[i] = ((newRotations[i] || 0) + 90) % 360;
      }
      return newRotations;
    });
  };

  const pages = Array.from({ length: pageCount }, (_, i) => i + 1);
  const hasRotations = Object.values(rotations).some(r => r !== 0);

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 p-4">
      <div className="bg-white rounded-xl shadow-xl w-full max-w-4xl max-h-[90vh] flex flex-col">
        <div className="flex justify-between items-center p-4 border-b">
          <h2 className="text-xl font-bold">{title}</h2>
          <button onClick={onCancel} className="p-2 hover:bg-gray-100 rounded-full transition-colors">
            <X className="w-5 h-5 text-gray-500" />
          </button>
        </div>

        <div className="flex-1 overflow-y-auto p-4 bg-gray-50">
          <div className="flex justify-between items-center mb-4">
            <span className="text-sm text-gray-600">Click the arrow on each page to rotate it.</span>
            <button
              onClick={handleRotateAll}
              className="flex items-center gap-2 px-3 py-1.5 bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 transition-colors text-sm font-medium"
            >
              <RotateCw className="w-4 h-4" />
              Rotate All 90°
            </button>
          </div>
          <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
            {pages.map((pageNum) => {
              const rotation = rotations[pageNum] || 0;
              return (
                <div
                  key={pageNum}
                  className="relative rounded-lg border-2 border-transparent hover:border-gray-300 transition-all bg-white flex flex-col items-center p-2"
                >
                  <div
                    className="bg-gray-100 rounded-md overflow-hidden transition-transform duration-300 w-full flex items-center justify-center min-h-[150px]"
                    style={{ transform: `rotate(${rotation}deg)` }}
                  >
                     <PDFPageThumbnail
                        docId={docId}
                        pageNumber={pageNum}
                        width={150}
                        thumbnailCache={thumbnailCache}
                        setThumbnailCache={setThumbnailCache}
                     />
                  </div>
                  <div className="w-full flex justify-between items-center mt-2">
                    <span className="text-xs text-gray-500 font-medium">Page {pageNum}</span>
                    <button
                      onClick={() => handleRotatePage(pageNum)}
                      className="p-1.5 bg-gray-100 hover:bg-blue-100 text-gray-600 hover:text-blue-600 rounded-full transition-colors"
                      title="Rotate 90°"
                    >
                      <RotateCw className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <div className="p-4 border-t bg-white flex justify-end items-center gap-2">
          <button
            onClick={onCancel}
            className="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors"
          >
            Cancel
          </button>
          <button
            onClick={() => onConfirm(rotations)}
            disabled={!hasRotations}
            className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Apply Changes
          </button>
        </div>
      </div>
    </div>
  );
}
